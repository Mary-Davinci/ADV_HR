# ADV_HR — variabili d'ambiente di esempio.
# Copia in `.env.local` e compila i valori. NON committare mai `.env.local`.
# Nessuna di queste variabili è esposta al browser.

# Segreto per firmare/cifrare la sessione Auth.js (min. 32 byte casuali).
# Generalo con: npx auth secret   oppure   openssl rand -base64 32
AUTH_SECRET=

# Database PostgreSQL di ADV_HR (sviluppo: `npm run db:up`, porta 5433).
# In altri ambienti usare credenziali dedicate, mai quelle di sviluppo.
DATABASE_URL=postgres://adv_hr:adv_hr_dev@127.0.0.1:5433/adv_hr

# Sorgente dati dei repository. Valori ammessi: postgres
# (i dati ADV CORE arrivano nel database ADV_HR con la sincronizzazione, vedi sotto)
DATA_SOURCE=postgres

# --- Sincronizzazione ADV CORE (npm run sync:adv-core, docs/ADV_CORE_BRIDGE.md) ---
# Indirizzo del gestionale ADV CORE (https obbligatorio, http solo per ambienti locali).
ADV_CORE_API_URL=
# Chiave API fornita dall'amministratore di ADV CORE. Segreta: mai in git, email o chat.
ADV_CORE_API_KEY=
# Scarica anche i CV dei candidati (true/false).
ADV_CORE_SYNC_DOCUMENTS=true
# Cartella dei log mensili della sincronizzazione (esclusa da git).
ADV_CORE_SYNC_LOG_DIR=./storage/logs
# Solo dove il pianificatore usa l'ora UTC (cron di Railway): orari italiani validi,
# le esecuzioni pianificate fuori orario vengono saltate. Sul PC ufficio lasciare vuoto.
# ADV_CORE_SYNC_TIMES=13:20,18:20

# --- Storage dei documenti (CV, moduli firmati, allegati) ---
# local = cartella su disco (sviluppo, PC ufficio); s3 = bucket S3 compatibile (Railway).
DOCUMENT_STORAGE_PROVIDER=local
# Cartella dello storage locale (esclusa da git). Con s3 è la SORGENTE di `npm run storage:to-s3`.
DOCUMENT_STORAGE_DIR=./storage/documents
# Con DOCUMENT_STORAGE_PROVIDER=s3 (su Railway: riferimenti alle variabili del bucket,
# es. S3_BUCKET=${{Bucket.BUCKET}}; la scheda Credentials indica se serve il path-style).
# S3_BUCKET=
# S3_ENDPOINT=https://t3.storageapi.dev
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PREFIX=documents/

# Mostra nel login il riferimento agli utenti di sviluppo del seed.
AUTH_SHOW_DEV_HINT=true

# (Opzionale) password degli utenti creati da `npm run db:seed` / `db:reset`.
# Se assente si usa la password di sviluppo indicata nel README.
# SEED_USER_PASSWORD=

# --- Modulo Job Description inviato alle aziende ---
# Indirizzo pubblico di ADV_HR, usato nei link delle email (es. https://hr.davinciformazione.com).
APP_PUBLIC_URL=http://localhost:3000

# Invio email (casella Aruba del dominio). Senza SMTP_HOST le mail NON partono:
# vengono salvate come file .eml in MAIL_OUTBOX_DIR (sviluppo e collaudo).
# SMTP_HOST=smtps.aruba.it
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=selezione@davinciformazione.com
# SMTP_PASSWORD=
# MAIL_FROM="Accademia Da Vinci - Selezione <selezione@davinciformazione.com>"
# Destinatario delle notifiche HR se l'autore della richiesta non ha un'email reale.
# HR_NOTIFICATION_EMAIL=selezione@davinciformazione.com
MAIL_OUTBOX_DIR=./storage/mail-outbox
